# Fichier d'exemple pour les variables d'environnement locales
# COPIEZ ce fichier en .env et remplissez les valeurs
# NE COMMITEZ JAMAIS le fichier .env — il est dans .gitignore

# =============================================================================
# Supabase
# =============================================================================
# Récupérer dans : Supabase Dashboard → Settings → API
SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_VOTRE_CLE_SERVICE_ROLE

# =============================================================================
# Notifications Slack (optionnel — peut être vide en Phase 1)
# =============================================================================
# Créer un Incoming Webhook dans : Slack → Apps → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/VOTRE/WEBHOOK/URL
